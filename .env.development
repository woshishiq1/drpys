# ===== drpy-node 开发/构建环境变量 =====
# 日志
LOG_WITH_FILE=0
LOG_LEVEL=info

# 终端（Dockerfile 会 sed 成 1）
ENABLE_TERMINAL=0

# Python 虚拟环境（Dockerfile 会 sed 成 /app/.venv）
VIRTUAL_ENV=

# 认证（API_AUTH 给 basic auth，API_PWD 给接口密码）
API_AUTH_NAME=admin
API_AUTH_CODE=drpys
API_PWD=dzyyds

# 定时任务
ENABLE_TASKER=1

# 默认 req 实现
DS_REQ_LIB=0

# 设置中心入库授权码
COOKIE_AUTH_CODE=drpys
